cluster-config ./petrichor_timestep.yaml 
--imaging-strategy emu_deep.yaml
--expected-ms 36
--subtract-data-column "SUBTRACT_DATA"
--data-column "CORRECTED_DATA"
--attempt-subtract
#--use-crystalball
--timestep-image
--max-intervals 20000
# At most this many time steps are imaged and linmos'd at once
--max-intervals-in-flight 128
# Up to this many failed time steps are left out of the cube before the flow
# fails. 0 fails the run on any failure
--max-failed-intervals 10
# Removing the per-interval images is set in the strategy,
# subtractcube: fitscube: remove_original_images (default true)
--memory-fraction 0.2
#--row-chunks 25000 #used by crystallball
#--model-chunks 2000 #used by crystallball
#--subtract-only
